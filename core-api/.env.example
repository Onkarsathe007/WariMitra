# Core API Environment Variables
NODE_ENV=development
PORT=3000

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017/visava?authSource=admin"

# Redis Configuration (Used for Geo-service caching if needed)
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=visava-internal-secret-token-2024

# Third-party Integrations (Optional for local dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# External Service URLs
GEO_SERVICE_URL=http://localhost:8081

# Web Server Settings
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Vapi Credentials (Required if triggering outbound calls manually)
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_PRIVATE_KEY=your_vapi_private_key_here
